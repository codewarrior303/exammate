{
  "id": "/",
  "name": "ExamMate — Exam Routine Planner",
  "short_name": "ExamMate",
  "description": "Build your personal exam schedule, export it, and optionally sync it with Google Calendar.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=installed-app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0A1118",
  "theme_color": "#0A1118",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/exammate-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/exammate-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/exammate-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Generate an exam routine",
      "short_name": "Generate routine",
      "description": "Open the routine upload and course matching form.",
      "url": "/#generator",
      "icons": [
        {
          "src": "/icons/exammate-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View my exam schedule",
      "short_name": "My schedule",
      "description": "Jump to the generated exam schedule.",
      "url": "/#results",
      "icons": [
        {
          "src": "/icons/exammate-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
